	//左边界
uint16_t LEIDA_DATA_HANDLE6(_LEIDA_DATA_plane data_left_plane[],_LEIDA_DATA data_center[],_LEIDA_DATA arr[],u16 size){							//找到左边界  180-90
	int i = 0;
	int center_cnt=0;
	float angle_left;	

	printf("BLUE_ANGLE_LEFT_RIGHT=%.1f\n",BLUE_ANGLE_LEFT_RIGHT);
	for(angle_left = LEIDA_ANGLE_LEFT; angle_left>= LEIDA_ANGLE_LEFT-BLUE_ANGLE_LEFT_RIGHT ; angle_left-=LEIDA_ANGLE_resolution ){
		for(i=0;i<size;i++){
			if((fabs(arr[i].angle-angle_left)<=LEIDA_ANGLE_piancha)&&(arr[i].distance<=2500)){
				data_left_plane[center_cnt]._x = arr[i].distance*arm_cos_f32(arr[i].angle*PI/180);
				data_left_plane[center_cnt]._y = arr[i].distance*arm_sin_f32(arr[i].angle*PI/180);
				data_center[center_cnt].angle = arr[i].angle;
				data_center[center_cnt].distance = arr[i].distance;
				printf("左边界data_left[i].angle：%.2f， data_left[j].distance：%.2f\n",data_center[center_cnt].angle,data_center[center_cnt].distance);
				
				center_cnt++;
				break;		
			}					
		}
	}
	return center_cnt;
}
//右边界
uint16_t LEIDA_DATA_HANDLE7(_LEIDA_DATA_plane data_right_plane[],_LEIDA_DATA data_center[],_LEIDA_DATA arr[],u16 size){											//找到右边界0-90
	int i = 0;
	int center_cnt=0;
	float angle_right;	

	//0到90度
	for(angle_right = 0; angle_right<= LEIDA_ANGLE_RIGHT+BLUE_ANGLE_LEFT_RIGHT ; angle_right+=LEIDA_ANGLE_resolution ){
		for(i=size-1;i>=0;i--){
			if((fabs(arr[i].angle-angle_right)<=LEIDA_ANGLE_piancha))
			{
				data_right_plane[center_cnt]._x = arr[i].distance*arm_cos_f32(arr[i].angle*PI/180);
				data_right_plane[center_cnt]._y = arr[i].distance*arm_sin_f32(arr[i].angle*PI/180);
				data_center[center_cnt].angle = arr[i].angle;
				data_center[center_cnt].distance = arr[i].distance;
				printf("右边界data_left[%d].angle：%.2f， data_left[%d].distance：%.2f\n",i,data_center[center_cnt].angle,i,data_center[center_cnt].distance);
				
				center_cnt++;
				break;
			}				
		}		
	}
	return center_cnt;
}



























